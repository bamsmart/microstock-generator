# ==============================================================================
# Microstock Generator - 100% Free-Tier API Keys (.env template)
# Copy this file to `.env` and fill in the free keys you want to activate.
# Zero credit card required for all providers below.
# ==============================================================================

# 1. Google AI Studio (Gemini Flash Free Tier) — Primary Vision QC + SEO Metadata (Step 4)
#    Get free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# 2. Groq Free Tier (Llama 3.3 70B) — Primary Text LLM for High-Demand Research & Prompts (Step 1)
#    Get free key: https://console.groq.com/keys
GROQ_API_KEY=""

# 3. Mistral AI Experiment Free Tier — Optional Fallback #1 for Text/JSON
#    Get free key: https://console.mistral.ai/
MISTRAL_API_KEY=""

# 4. OpenRouter (:free models) — Optional Fallback for Vision & Text
#    Get free key: https://openrouter.ai/keys
OPENROUTER_API_KEY= ""

# 5. Adobe Stock Contributor SFTP (Step 5: Auto Upload)
#    Get credentials: https://contributor.stock.adobe.com/ -> Upload -> Learn more about SFTP
ADOBE_SFTP_HOST=sftp.contributor.adobestock.com
ADOBE_SFTP_PORT=22
ADOBE_SFTP_USER=
ADOBE_SFTP_PASS=""
